# ContribMate AI Environment Variables

# GitHub Token (Optional for public REST API, recommended for rate limits)
GITHUB_TOKEN=

# AI Provider Configuration (Hosted Qwen, Groq, Ollama, OpenAI-compatible)
GROQ_API_KEY=
AI_MODEL=qwen-2.5-coder-32b
AI_BASE_URL=https://api.groq.com/openai/v1

# Database Configuration (PostgreSQL or SQLite fallback)
DATABASE_URL=sqlite:///./contribmate.db

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Embedding Model
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Demo Mode (true enables realistic demo data fallback if live credentials missing)
DEMO_MODE=true
